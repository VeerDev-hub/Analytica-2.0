# Copy to .env and adjust. docker compose reads this file automatically.
# These defaults are for LOCAL development only - never reuse them in AWS.

ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

POSTGRES_USER=analytica
POSTGRES_PASSWORD=analytica
POSTGRES_DB=analytica

# Must match infra/local/seaweedfs-s3.json
S3_ACCESS_KEY=analytica
S3_SECRET_KEY=analytica-secret
S3_BUCKET=analytica-data

# Auth: set a long random value outside local development
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0123456789

# Chat assistant (Phase 4). Leave empty to disable chat.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5-5

# Admin: these emails become admins when they sign in (comma-separated)
ADMIN_EMAILS=

# Sign in with Google / GitHub. Leave empty to hide that option.
# Callback URLs to register with the provider:
#   http://localhost:5173/api/v1/auth/oauth/google/callback
#   http://localhost:5173/api/v1/auth/oauth/github/callback
PUBLIC_APP_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Host ports (change if something else on your machine already uses them)
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6380
S3_HOST_PORT=8333
